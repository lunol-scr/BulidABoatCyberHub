-- Функция создания строки функции
local function CreateFeatureRow(parent, name, description, initialValue, onToggle)
    local row = Instance.new("Frame")
    row.Name = name
    row.Size = UDim2.new(1, -20, 0, 80)
    row.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    row.BorderSizePixel = 0
    row.Parent = parent

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -60, 0, 20)
    nameLabel.Position = UDim2.new(0, 10, 0, 5)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.Font = Enum.Font.GothamSemibold
    nameLabel.TextSize = 14
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent = row

    local descLabel = Instance.new("TextLabel")
    descLabel.Size = UDim2.new(1, -60, 0, 40)
    descLabel.Position = UDim2.new(0, 10, 0, 30)
    descLabel.BackgroundTransparency = 1
    descLabel.Text = description
    descLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    descLabel.Font = Enum.Font.Gotham
    descLabel.TextSize = 12
    descLabel.TextXAlignment = Enum.TextXAlignment.Left
    descLabel.TextWrapped = true
    descLabel.Parent = row

    local toggleFrame = Instance.new("Frame")
    toggleFrame.Name = "Toggle"
    toggleFrame.Size = UDim2.new(0, 50, 0, 24)
    toggleFrame.Position = UDim2.new(1, -60, 0, 10)
    toggleFrame.BackgroundColor3 = initialValue and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(80, 80, 80)
    toggleFrame.BorderSizePixel = 0
    toggleFrame.Parent = row

    local knob = Instance.new("Frame")
    knob.Name = "Knob"
    knob.Size = UDim2.new(0, 20, 0, 20)
    knob.Position = initialValue and UDim2.new(1, -22, 0, 2) or UDim2.new(0, 2, 0, 2)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.Parent = toggleFrame

    local stateLabel = Instance.new("TextLabel")
    stateLabel.Size = UDim2.new(1, 0, 1, 0)
    stateLabel.BackgroundTransparency = 1
    stateLabel.Text = initialValue and "ON" or "OFF"
    stateLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    stateLabel.Font = Enum.Font.GothamBold
    stateLabel.TextSize = 10
    stateLabel.TextXAlignment = Enum.TextXAlignment.Center
    stateLabel.TextYAlignment = Enum.TextYAlignment.Center
    stateLabel.Parent = knob

    local isOn = initialValue

    local function updateVisual()
        toggleFrame.BackgroundColor3 = isOn and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(80, 80, 80)
        knob.Position = isOn and UDim2.new(1, -22, 0, 2) or UDim2.new(0, 2, 0, 2)
        stateLabel.Text = isOn and "ON" or "OFF"
    end

    local toggleButton = Instance.new("TextButton")
    toggleButton.Size = UDim2.new(1, 0, 1, 0)
    toggleButton.BackgroundTransparency = 1
    toggleButton.Text = ""
    toggleButton.Parent = toggleFrame
    toggleButton.MouseButton1Click:Connect(function()
        isOn = not isOn
        updateVisual()
        if onToggle then
            onToggle(isOn)
        end
    end)

    local featureObj = {
        SetValue = function(value)
            isOn = value
            updateVisual()
            if onToggle then
                onToggle(isOn)
            end
        end,
        GetValue = function()
            return isOn
        end,
        Row = row,
        Name = name,
        onToggle = onToggle
    }

    table.insert(allFeatures, featureObj)
    return featureObj
end

