-- ==================== ЗАМОРОЗКА ПЕРСОНАЖА ====================
local function freezeCharacter(character)
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return end

    -- Останавливаем текущий полёт, если он активен
    stopFly()

    -- Замораживаем: запрещаем движение, прыжки, падение
    humanoid.PlatformStand = true
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.AutoRotate = false
    rootPart.Anchored = true  -- Гарантированно предотвращает падение
end

local function unfreezeCharacter(character)
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoid then return end

    -- Возвращаем стандартные значения (можно подстроить под игру)
    humanoid.PlatformStand = false
    humanoid.WalkSpeed = 16 -- Стандартная скорость ходьбы (можно изменить)
    humanoid.JumpPower = 50 -- Стандартная сила прыжка (можно изменить)
    humanoid.AutoRotate = true
    if rootPart then
        rootPart.Anchored = false
    end
end

-- ==================== АВТОФАРМ ====================
local autoFarmEnabled = false
local autoFarmCoroutine = nil

local teleportTargets = {
    workspace.BoatStages.NormalStages.CaveStage1.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage2.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage3.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage4.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage5.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage6.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage7.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage8.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage9.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage10.DarknessPart,
    workspace.BoatStages.NormalStages.TheEnd.GoldenChest.Trigger
}

local function startAutoFarm()
    if autoFarmCoroutine and coroutine.status(autoFarmCoroutine) ~= "dead" then
        -- Если корутина уже работает, просто ставим флаг и выходим
        autoFarmEnabled = true
        return
    end

    autoFarmEnabled = true
    autoFarmCoroutine = coroutine.create(function()
        while autoFarmEnabled do
            -- Ждём появления персонажа
            local character = player.Character
            if not character or not character:FindFirstChild("HumanoidRootPart") then
                player.CharacterAdded:Wait()
                character = player.Character
                if not character then continue end
            end

            local humanoid = character:WaitForChild("Humanoid")
            local rootPart = character:WaitForChild("HumanoidRootPart")

            -- Замораживаем персонажа (отключаем полёт и движение, предотвращаем падение)
            freezeCharacter(character)

            -- Телепортируемся по всем целям
            for i, target in ipairs(teleportTargets) do
                if not autoFarmEnabled then break end
                if target and target:IsA("BasePart") then
                    rootPart.CFrame = target.CFrame * CFrame.new(0, 3, 0)
                end
                -- Ждём 2 секунды на каждой точке, кроме последней
                if i < #teleportTargets then
                    local waitTime = 0
                    while waitTime < 2 and autoFarmEnabled do
                        task.wait(0.1)
                        waitTime += 0.1
                    end
                end
            end

            -- Ожидание 45 секунд перед следующим циклом
            if autoFarmEnabled then
                local waitTime = 0
                while waitTime < 45 and autoFarmEnabled do
                    task.wait(1)
                    waitTime += 1
                end
            end

            -- Размораживаем перед возможным повторным циклом (если не выключен)
            if autoFarmEnabled then
                unfreezeCharacter(character)
            end
        end
    end)
    coroutine.resume(autoFarmCoroutine)
end

local function stopAutoFarm()
    autoFarmEnabled = false
    if autoFarmCoroutine then
        coroutine.close(autoFarmCoroutine)
        autoFarmCoroutine = nil
    end

    -- Размораживаем текущего персонажа, если он есть
    local character = player.Character
    if character then
        unfreezeCharacter(character)
    end
end

local autoFarmFeature = CreateFeatureRow(
    scrollingFrame,
    "Auto Farm",
    "Teleports through all CaveStage DarknessParts, waits 2s at each, then waits 45s and repeats. Restarts after death.",
    false,
    function(value)
        if value then
            startAutoFarm()
        else
            stopAutoFarm()
        end
    end
)

