-- Заморозка/разморозка
local function freezeCharacter(character)
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return end

    stopFly()
    humanoid.PlatformStand = true
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.AutoRotate = false
    rootPart.Anchored = true
end

local function unfreezeCharacter(character)
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoid then return end

    humanoid.PlatformStand = false
    humanoid.WalkSpeed = 16
    humanoid.JumpPower = 50
    humanoid.AutoRotate = true
    if rootPart then
        rootPart.Anchored = false
    end
end

-- Поиск всех SpawnLocation
local spawnLocations = {}
local function updateSpawnLocations()
    spawnLocations = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name == "SpawnLocation" then
            table.insert(spawnLocations, obj)
        end
    end
end
updateSpawnLocations()

-- Функция проверки, стоит ли персонаж на SpawnLocation
local function isOnSpawnLocation(character)
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    for _, spawnPart in ipairs(spawnLocations) do
        if (rootPart.Position - spawnPart.Position).Magnitude <= 10 then
            return true
        end
    end
    return false
end

-- Автофарм
local autoFarmEnabled = false
local autoFarmCoroutine = nil

local teleportTargets = {
    workspace.BoatStages.NormalStages.CaveStage1.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage2.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage3.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage4.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage5.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage6.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage7.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage8.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage9.DarknessPart,
    workspace.BoatStages.NormalStages.CaveStage10.DarknessPart,
    workspace.BoatStages.NormalStages.TheEnd.GoldenChest.Trigger
}

local function startAutoFarm()
    if autoFarmCoroutine and coroutine.status(autoFarmCoroutine) ~= "dead" then
        autoFarmEnabled = true
        return
    end

    autoFarmEnabled = true
    autoFarmCoroutine = coroutine.create(function()
        while autoFarmEnabled do
            -- Ожидание персонажа с проверкой флага
            while autoFarmEnabled and not player.Character do
                task.wait(0.5)
            end
            if not autoFarmEnabled then break end

            local character = player.Character
            local humanoid = character:WaitForChild("Humanoid")
            local rootPart = character:WaitForChild("HumanoidRootPart")

            local shouldRestart = false

            -- Замораживаем персонажа перед телепортациями
            freezeCharacter(character)

            -- Проходим все точки
            for i, target in ipairs(teleportTargets) do
                if not autoFarmEnabled then break end
                if target and target:IsA("BasePart") then
                    -- Телепортируемся, оставляя персонажа замороженным (даже на сундуке)
                    rootPart.CFrame = target.CFrame * CFrame.new(0, 3, 0)
                end
                -- Ждём 2 секунды на каждой точке, кроме последней
                if i < #teleportTargets then
                    local waitTime = 0
                    while waitTime < 2 and autoFarmEnabled do
                        task.wait(0.1)
                        waitTime += 0.1
                        if isOnSpawnLocation(character) then
                            shouldRestart = true
                            break
                        end
                    end
                    if shouldRestart then break end
                end
            end

            -- Ожидание 45 секунд перед следующим циклом
            if autoFarmEnabled and not shouldRestart then
                local waitTime = 0
                while waitTime < 45 and autoFarmEnabled do
                    task.wait(1)
                    waitTime += 1
                    if isOnSpawnLocation(character) then
                        break
                    end
                end
            end
        end
    end)
    coroutine.resume(autoFarmCoroutine)
end

local function stopAutoFarm()
    autoFarmEnabled = false
    local character = player.Character
    if character then
        unfreezeCharacter(character)
    end
end

local autoFarmFeature = CreateFeatureRow(
    scrollingFrame,
    "Auto Farm",
    "Teleports through CaveStage DarknessParts (frozen), stays frozen at GoldenChest to avoid death. Restarts if on SpawnLocation.",
    false,
    function(value)
        if value then
            startAutoFarm()
        else
            stopAutoFarm()
        end
    end
)

